  service_providers   service_providers?    @relation(fields: [provider_id], references: [id], onUpdate: NoAction)
  profiles            profiles              @relation(fields: [requested_by], references: [id], onUpdate: NoAction)
  spaces              spaces?               @relation(fields: [space_id], references: [id], onUpdate: NoAction)
  maintenance_updates maintenance_updates[]
  property_expenses   property_expenses[]
  provider_reviews    provider_reviews?

  @@index([property_id], map: "idx_maintenance_property_id")
  @@index([provider_id], map: "idx_maintenance_provider_id")
  @@index([category_id])
  @@index([requested_by])
  @@index([space_id])
}

