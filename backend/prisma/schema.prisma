generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String              @db.VarChar(100)
  email         String              @unique(map: "users_email_key") @db.VarChar(254)
  password_hash String              @db.VarChar(255)
  phone         String?             @db.VarChar(20)
  role          spacecare_user_role @default(CUSTOMER)
  is_active     Boolean             @default(true)
  updated_at    DateTime            @default(now()) @db.Timestamptz(6)

  @@ignore
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model ai_action_logs {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String            @db.Uuid
  conversation_id       String?           @db.Uuid
  action_name           String            @db.VarChar(100)
  target_type           String?           @db.VarChar(100)
  target_id             String?           @db.Uuid
  arguments             Json?
  confirmation_required Boolean           @default(true)
  confirmed_at          DateTime?         @db.Timestamptz(6)
  status                ai_action_status  @default(REQUESTED)
  result                Json?
  created_at            DateTime          @default(now()) @db.Timestamptz(6)
  ai_conversations      ai_conversations? @relation(fields: [conversation_id], references: [id], onUpdate: NoAction)
  profiles              profiles          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_ai_action_logs_user_id")
  @@index([conversation_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model ai_conversations {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String           @db.Uuid
  title          String?          @db.VarChar(200)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  ai_action_logs ai_action_logs[]
  profiles       profiles         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_messages    ai_messages[]

  @@index([user_id], map: "idx_ai_conversations_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model ai_messages {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id  String           @db.Uuid
  role             ai_message_role
  content          String
  tool_name        String?          @db.VarChar(100)
  metadata         Json?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  ai_conversations ai_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id], map: "idx_ai_messages_conversation_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model booking_status_history {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id  String          @db.Uuid
  from_status booking_status?
  status      booking_status
  changed_by  String          @db.Uuid
  note        String?
  changed_at  DateTime        @default(now()) @db.Timestamptz(6)
  bookings    bookings        @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles    profiles        @relation(fields: [changed_by], references: [id], onUpdate: NoAction)

  @@index([booking_id])
  @@index([changed_by])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model bookings {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  space_id               String                   @db.Uuid
  customer_id            String                   @db.Uuid
  start_at               DateTime                 @db.Timestamptz(6)
  end_at                 DateTime                 @db.Timestamptz(6)
  guest_count            Int                      @default(1)
  status                 booking_status           @default(PENDING)
  base_amount            Decimal                  @db.Decimal(12, 2)
  platform_fee           Decimal                  @default(0) @db.Decimal(12, 2)
  total_amount           Decimal                  @db.Decimal(12, 2)
  owner_amount           Decimal                  @db.Decimal(12, 2)
  cancellation_reason    String?
  tax_amount             Decimal                  @default(0) @db.Decimal(12, 2)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  booking_status_history booking_status_history[]
  profiles               profiles                 @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  spaces                 spaces                   @relation(fields: [space_id], references: [id], onUpdate: NoAction)
  payments               payments[]
  space_reviews          space_reviews?

  @@index([customer_id], map: "idx_bookings_customer_id")
  @@index([space_id], map: "idx_bookings_space_id")
  @@index([space_id, start_at, end_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model favorites {
